# Server
SERVER_PORT=8080
GIN_MODE=debug

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=growvest
DB_PASSWORD=changeme
DB_NAME=growvest_db
DB_SSLMODE=disable

# JWT - MUST change in production (min 32 chars)
JWT_SECRET=change-this-to-a-random-secret-min-32-chars
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Redis (optional - runs without cache if unavailable)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Google OAuth2 (optional - leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# App
APP_ENV=development
LOG_LEVEL=info
